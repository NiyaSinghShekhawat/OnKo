rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(patientId) {
      return signedIn() && request.auth.uid == patientId;
    }

    function isDoctor() {
      return signedIn() &&
        request.auth.token.role == "doctor";
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.role == "admin";
    }

    match /patients/{patientId} {
      allow read: if isOwner(patientId) || isDoctor() || isAdmin();
      allow write: if isDoctor() || isAdmin();
    }

    match /{collection}/{documentId} {
      allow read, write: if isDoctor() || isAdmin();
    }
  }
}
